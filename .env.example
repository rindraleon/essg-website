# Environment Configuration Template
# Copy this file to .env.local or .env.{environment} and fill in your values

# ========== Development ==========
# Development API endpoint
VITE_API_URL_DEV=http://localhost:3001

# ========== Staging ==========
# Staging API endpoint
STAGING_API_URL=https://api-staging.example.com

# Docker registry for staging
REGISTRY_STAGING=docker.io
DOCKER_ORG_STAGING=your-org

# ========== Production ==========
# Production API endpoint
PROD_API_URL=https://api.example.com

# Docker registry for production
REGISTRY_PROD=docker.io
DOCKER_ORG_PROD=your-org

# ========== Docker Build ==========
# Registry and image naming
REGISTRY=docker.io
DOCKER_ORG=your-docker-org
DOCKER_USERNAME=your-docker-username
DOCKER_PASSWORD=your-docker-password-or-token

# Image tags
FRONTEND_TAG=latest
BACKEND_TAG=latest

# ========== Deployment ==========
# Staging deployment
STAGING_HOST=staging-server.example.com
STAGING_USER=deploy
STAGING_DEPLOY_KEY=/path/to/staging/key

# Production deployment
PROD_HOST=prod-server.example.com
PROD_USER=deploy
PROD_DEPLOY_KEY=/path/to/prod/key
